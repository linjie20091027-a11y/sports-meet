# ==========================================
# 运动会管理系统 - 环境变量配置模板
# 部署时复制为 .env 并修改实际值
# ==========================================

# 服务端口
PORT=3000

# JWT 密钥（生产环境请修改为强随机字符串）
JWT_SECRET=sports_meet_secret_key_2026

# 本地数据库路径（当前运行时仍使用本地 SQLite 文件）
LOCAL_DB_PATH=database/sports_meet.db

# 云端数据库（PostgreSQL / Neon / Supabase / Railway 等兼容连接串）
DATABASE_URL=postgresql://user:password@host:5432/sports_meet?sslmode=require
CLOUD_DB_SCHEMA=public
CLOUD_DB_SSL=true
CLOUD_DB_CONNECT_TIMEOUT_MS=10000
CLOUD_DB_BACKUP_DIR=database/backups/cloud
CLOUD_DB_BACKUP_RETENTION=10

# 本地数据库自动备份
DB_BACKUP_RETENTION=10

# 管理员账号（首次启动自动创建）
ADMIN_EMAIL=admin@hkms.hktedu.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=系统管理员

# 邮件配置（忘记密码功能，可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 网站信息
SITE_NAME=学校运动会管理系统
SITE_URL=http://localhost:3000
TIMEZONE=Asia/Shanghai

# 报名规则
MAX_EVENTS_PER_STUDENT=3
SESSION_HOURS=24
